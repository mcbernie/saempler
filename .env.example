# Machine-specific standalone settings. Copy to `.env` and adjust.
# Find the device names with `just devices`.
#
# Values containing spaces must be quoted.

# auto, jack, dummy, plus wasapi (Windows), core-audio (macOS), alsa (Linux).
SAEMPLER_BACKEND=auto

# Must match what the audio device actually delivers. If it does not, the
# standalone panics and names the correct value in the message.
SAEMPLER_PERIOD_SIZE=512

SAEMPLER_SAMPLE_RATE=48000

# Leave empty to start without a MIDI input.
SAEMPLER_MIDI_INPUT=""
